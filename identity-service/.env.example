# Identity service settings. Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://identity:identity%402026@127.0.0.1:5433/identity
# Tests only (database name must end with _test; it is dropped and recreated):
TEST_DATABASE_URL=postgresql+asyncpg://identity:CHANGE_ME@localhost:5432/identity_test
ALLOWED_ORIGINS=["http://localhost:5173"]
DOCS_ENABLED=true

# RS256 signing key (PEM, one line with \n). Generate: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
JWT_PRIVATE_KEY=
JWT_KEY_ID=identity-1
JWT_ISSUER=evr-identity
JWT_AUDIENCE=evr-erp
SESSION_HOURS=8
AUTH_COOKIE_NAME=evr_session
# true in production (HTTPS). false only for local http development.
AUTH_COOKIE_SECURE=true

# Password policy and lockout (PENDING IT confirmation).
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_LETTER_AND_DIGIT=true
LOCKOUT_ATTEMPTS=5
LOCKOUT_MINUTES=15
LOGIN_RATE_PER_IP_PER_MINUTE=30

# HRMS base URL, for employee and department names on accounts (called with the caller's session).
HRMS_BASE_URL=http://localhost:8000

# Service clients: {"client-id": "<sha256 hex of its secret>"} and their scopes.
SERVICE_CLIENTS={}
SERVICE_CLIENT_SCOPES={"hrms-service": ["identity:sessions.read", "identity:users.read"]}
SERVICE_TOKEN_MINUTES=15
