# Manufacturing service settings. Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://manufacturing:manufacturing%402026@127.0.0.1:5433/manufacturing
TEST_DATABASE_URL=postgresql+asyncpg://manufacturing:CHANGE_ME@localhost:5432/manufacturing_test
ALLOWED_ORIGINS=["http://localhost:5173"]
DOCS_ENABLED=true

# Session tokens from the Identity service.
AUTH_JWKS_URL=http://localhost:8001/.well-known/jwks.json
AUTH_JWT_ISSUER=evr-identity
AUTH_JWT_AUDIENCE=evr-erp
AUTH_REVOCATION_URL=http://localhost:8001/internal/sessions
IDENTITY_BASE_URL=http://localhost:8001
IDENTITY_CLIENT_ID=manufacturing-service
IDENTITY_CLIENT_SECRET=

# PENDING production planning.
DUE_WINDOW_DAYS=14
TESTING_STAGE_CODE=
