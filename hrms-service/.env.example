# HRMS service configuration. Copy to .env for local development; in production set these as
# real environment variables (never commit .env). Lists are JSON arrays.

# --- Service ---------------------------------------------------------------
ENVIRONMENT=development            # development | test | staging | production
LOG_LEVEL=INFO
DOCS_ENABLED=true                  # must be false in production (Swagger at /docs)
# Browser origins of the frontend, for the CSRF origin check.
ALLOWED_ORIGINS=["http://localhost:5173"]

# --- Database (HRMS's own PostgreSQL database) -----------------------------
DATABASE_URL=postgresql+asyncpg://hrms:hrms@2026@127.0.0.1:5433/hrms
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
# Used only by the test suite. The database name must end with _test; it is dropped and recreated.
TEST_DATABASE_URL=postgresql+asyncpg://hrms:CHANGE_ME@localhost:5432/hrms_test

# --- Authentication: tokens issued by the Identity service -------------------
# See docs/AUTH_INTEGRATION.md. Set ONE of the public key or the JWKS URL.
AUTH_COOKIE_NAME=evr_session
AUTH_JWT_ALGORITHMS=["RS256"]
AUTH_JWT_PUBLIC_KEY=
AUTH_JWKS_URL=
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=evr-erp
# Claim names, if Identity uses different ones.
AUTH_CLAIM_USER_ID=sub
AUTH_CLAIM_NAME=name
AUTH_CLAIM_SESSION_ID=sid
AUTH_CLAIM_EMPLOYEE_ID=employeeId
AUTH_CLAIM_ROLES=roles
AUTH_CLAIM_PERMISSIONS=permissions
# Session revocation check (empty = disabled, development only).
AUTH_REVOCATION_URL=
AUTH_REVOCATION_CACHE_SECONDS=60
IDENTITY_SERVICE_TOKEN=

# Development only (refused in production): accept HS256 tokens signed with this secret.
# Generate tokens with:  python -m app.scripts.dev_token --permissions "*"
AUTH_DEV_MODE=false
AUTH_DEV_SECRET=

# --- Files -----------------------------------------------------------------
STORAGE_DIR=storage
MAX_UPLOAD_BYTES=10485760
# Encryption keys for employee documents at rest (JSON list). REQUIRED in production; keep them
# in the server's secret store, never in git or in a ZIP. Losing every key loses the documents.
DOCUMENT_ENCRYPTION_KEYS=[]
# Malware scanning of uploads (contract A9). "clamav" needs a clamd service; "none" is refused in
# production. PENDING IT: where the scanner runs.
MALWARE_SCANNER=none
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30

# --- Employee import ------------------------------------------------------------------------------
# Limits proposed by the frontend contract (B6, pending HR/IT confirmation, R5).
IMPORT_MAX_ROWS=2000
IMPORT_MAX_FILE_BYTES=5242880
# Rows committed per transaction together with the job progress.
IMPORT_BATCH_SIZE=50

# --- Background worker (python -m app.worker) ----------------------------------------------------
WORKER_POLL_SECONDS=2
WORKER_STALE_SECONDS=300

# --- Employee data --------------------------------------------------------------------------------
# Encryption keys for sensitive payroll values (bank account numbers), as a JSON list. REQUIRED in
# production. The first key encrypts; keep older keys in the list until
# `python -m app.scripts.rotate_payroll_encryption` has re-encrypted everything with the first key.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Store the keys in the server's secret store, never in git. Losing every key loses the values.
PAYROLL_ENCRYPTION_KEYS=[]
# Company time zone for "today" (IANA name). PENDING: must match Platform's company settings.
COMPANY_TIME_ZONE=UTC

# --- Leave management (Module 6) ------------------------------------------------------------------
# Company working days as ISO weekdays (1 = Monday), JSON list, e.g. [1,2,3,4,5,6]. PENDING (L18):
# to come from Platform's company settings. Empty: no "working_days" escalation unit, and leave of
# employees without a shift is counted without excluding weekly offs (with a warning).
COMPANY_WORKING_DAYS=[]
# Leave attachments (frontend ATTACHMENT_RULES: .pdf .jpg .jpeg .png, 5 MB; pending HR/IT, L14).
LEAVE_ATTACHMENT_MAX_BYTES=5242880
LEAVE_MAX_ATTACHMENTS=5

# Payslip PDF heading (Module 7). Empty: the heading is just "Payslip".
PAYSLIP_COMPANY_NAME=
# HR workspace (Module 10): status codes counted as "active" employees, JSON list, e.g. ["active","on_probation"].
# PENDING HR. Empty: the dashboard shows the metric as unavailable.
WORKSPACE_ACTIVE_STATUS_CODES=[]

# --- Service tokens from Identity (preferred over the static tokens) ---------------------------------
# Client credentials registered in Identity's SERVICE_CLIENTS with scopes identity:sessions.read and
# platform:notifications.write. When set, HRMS fetches short-lived service tokens itself.
IDENTITY_BASE_URL=
IDENTITY_CLIENT_ID=hrms-service
IDENTITY_CLIENT_SECRET=

# --- Notifications to Platform (POST /internal/notifications) --------------------------------------
# PENDING Platform: until both are set, notifications stay queued (GET /hr/setup/notification-outbox).
# The token is a secret: keep it in the server's secret store, never in git or a ZIP.
PLATFORM_NOTIFICATIONS_URL=
PLATFORM_SERVICE_TOKEN=
NOTIFICATION_MAX_ATTEMPTS=8
