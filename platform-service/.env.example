# Platform service settings. Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://platform:platform%402026@127.0.0.1:5433/platform
TEST_DATABASE_URL=postgresql+asyncpg://platform:CHANGE_ME@localhost:5432/platform_test
ALLOWED_ORIGINS=["http://localhost:5173"]
DOCS_ENABLED=true

# Session tokens from the Identity service: the JWKS URL (or the public key PEM), issuer, audience, revocation.
AUTH_JWKS_URL=http://localhost:8001/.well-known/jwks.json
AUTH_JWT_ISSUER=evr-identity
AUTH_JWT_AUDIENCE=evr-erp
AUTH_REVOCATION_URL=http://localhost:8001/internal/sessions

# Service-to-service: Identity client credentials (scope identity:users.read and identity:sessions.read), HRMS URL.
IDENTITY_BASE_URL=http://localhost:8001
IDENTITY_CLIENT_ID=platform-service
IDENTITY_CLIENT_SECRET=
HRMS_BASE_URL=http://localhost:8000

# Fernet keys for integration secrets (JSON list). Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_ENCRYPTION_KEYS=[1EL1277b1BwmNuyZEiuWNJw90P_CiAu5JRDrTkHnYfY=]
# Categories whose in-app delivery cannot be switched off (PENDING HR/IT), e.g. ["approval"].
NOTIFICATION_MANDATORY_CATEGORIES=[]
